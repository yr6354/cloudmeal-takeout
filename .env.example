# 复制为 .env 后按需修改，docker compose 会自动读取

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root

# JWT 密钥：HS256 要求至少 32 字节，请务必替换为随机值
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-bytes-long
JWT_USER_SECRET=change-me-user-secret-at-least-32-bytes-long

# 以下为可选集成，未配置时相关功能自动降级（如文件上传、微信支付）
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET_NAME=
# WECHAT_APPID=
# WECHAT_SECRET=
# WECHAT_MCHID=
# WECHAT_MCH_SERIAL_NO=
# WECHAT_PRIVATE_KEY_FILE=
# WECHAT_API_V3_KEY=
# WECHAT_PAY_CERT_FILE=
# WECHAT_NOTIFY_URL=
# WECHAT_REFUND_NOTIFY_URL=
